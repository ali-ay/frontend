{% extends "landingPage.html.twig" %}
{% block pageTitle %}{{ pageContents.seo.title }}{% endblock %}
{% block description %}{{ pageContents.seo.description }}{% endblock %}
{% block openGraph %}
    <meta name="robots" content="noindex" />
    <meta property="og:title" content="{{ pageContents.seo.ogTitle }}" />
    <meta property="og:image" content="{{ pageContents.seo.ogImage }}" />
    <meta property="og:description" content="{{ pageContents.seo.ogDescription }}" />
{% endblock %}
{% block headerClasses %}full-height p-b-60 {% endblock %}
{% block bodyStyle %}background-color:transparent{% endblock %}
{% block parallaxBackgroundHolder %}
    <div class="cover-background" style="background-image:url({{ asset('assets/images/content/merchant-type-bg.jpg')}});"></div>
{% endblock %}

{% block bodyClass %} merchant-type mainMenu{% endblock %}

{% block main %}
<div class="merchantTypeContainer">
  <div class="mBoxContent">
    <div class="title">{{ translations.iyzicoMerchantType.title|raw }}</div>
    <div class="mBox-wrap">

      <a href="http://merchant.iyzipay.com/auth/mass-payout-login/{{ token }}" class="mBox left">
        <div class="mBox-title">{{ translations.iyzicoMerchantType.corparateTitle|raw }}</div>
        <ul>
          <li>{{ translations.iyzicoMerchantType.corparateContentOne|raw }}</li>
          <li>{{ translations.iyzicoMerchantType.corparateContentTwo|raw }}</li>
        </ul>
        <span>{{ translations.iyzicoMerchantType.corparateButtonText|raw }} <i class="fa fa-chevron-circle-right"></i></span>
      </a>
      <a href="https://consumer.iyzico.com/masspayout?token={{ token }}" class="mBox right">
        <div class="mBox-title">{{ translations.iyzicoMerchantType.personalTitle|raw }}</div>
        <ul>
          <li>{{ translations.iyzicoMerchantType.personalContent|raw }}</li>
        </ul>
        <span>{{ translations.iyzicoMerchantType.personalButtonText|raw }} <i class="fa fa-chevron-circle-right"></i></span>
      </a>
    </div>
  </div>
  <div class="mBoxFooter">
    <div class="subTitle">{{ translations.iyzicoMerchantType.subTitle|raw }}</div>
    <div class="bReferences">
      <img src="//media.iyzico.com/b/2017/04/zara_lp_2N.png" srcset="//media.iyzico.com/b/2017/04/zara_lp_2N@2x.png 2x">
      <img src="//media.iyzico.com/b/2018/05/avon.png" srcset="//media.iyzico.com/b/2018/05/avon@2x.png 2x">
      <img src="//media.iyzico.com/b/2017/04/sahibinden_LP_2N.png" srcset="//media.iyzico.com/b/2017/04/sahibinden_LP_2N@2x.png 2x">
      <img src="//media.iyzico.com/b/2017/04/ciceksepeti_LP_2N.png" srcset="//media.iyzico.com/b/2017/04/ciceksepeti_LP_2N@2x.png 2x">
      <img src="//media.iyzico.com/b/2017/04/evidea_2N.png" srcset="//media.iyzico.com/b/2017/04/evidea_2N@2x.png 2x">
      <img src="//media.iyzico.com/b/2017/02/Apsiyon.png" srcset="//media.iyzico.com/b/2017/02/Apsiyon@2x.png 2x">
      <img src="//media.iyzico.com/b/2018/06/pupa-logo.png" srcset="//media.iyzico.com/b/2018/06/pupa-logo@2x.png 2x">
      <img src="//media.iyzico.com/b/2018/05/nurus-logo.png" srcset="//media.iyzico.com/b/2018/05/nurus-logo@2x.png 2x">
    </div>
  </div>
</div>
{% endblock %}
