{% extends "landingPage.html.twig" %}
{% set memberUserId = app.session.get('memberUserId') %}
{% set registerSuccessMessages = app.session.flashBag.get('registerSuccess') %}
{% set failMessages = app.session.flashBag.get('error') %}
{% block pageTitle %}{{ pageContents.seo.title }}{% endblock %}
{% block description %}{{ pageContents.seo.description }}{% endblock %}
{% block openGraph %}
    <meta name="robots" content="noindex" />
    <meta property="og:title" content="{{ pageContents.seo.ogTitle }}" />
    <meta property="og:image" content="{{ pageContents.seo.ogImage }}" />
    <meta property="og:description" content="{{ pageContents.seo.ogDescription }}" />
    <meta name="robots" content="noindex">
{% endblock %}
{% block headerClasses %}full-height{% endblock %}
{% block bodyStyle %}background-color:transparent{% endblock %}

{% block bodyClass %} new-merchant mainMenu{% endblock %}
{% block headContent %}
    {% include '@root/Partials/_registerHeader.html.twig' %}
{% endblock %}
{% block main %}
{% if failMessages  %}
<!-- Fail Modal: Begin -->
<div class="newMerchantResult fail-modal">
  <div class="iyzi-container">
    <img src="https://media.iyzico.com/b/2020/10/cancelled.png" srcset="https://media.iyzico.com/b/2020/10/cancelled@2x.png">
    <h2>{{ translations.newiyzicoNotifications.newBirHataOlustu }}</h2>
    {% for flashMessage in failMessages %}
      <p>
        {{ flashMessage|raw }}
      </p>
    {% endfor %}
    <div class="buttonGroup">
      <a onclick="history.back()" class="button basic"><i class="icon icon--icn-leftarrow"></i>{{ translations.consumerRegisterSuccess.buttonTextBack }}</a>
      <a href="{{ path('hesap_olustur_landing_page') }}" class="button primary">{{ translations.consumerRegisterSuccess.buttonTextTryAgain }}</a>
    </div>
  </div>
</div>
<!-- Fail Modal: End -->
{% endif %}
{% if registerSuccessMessages  %}

  <div class="newMerchantResult fail-modal">
    <div class="iyzi-container">
      <img src="https://media.iyzico.com/b/2020/08/information-circle.png" srcset="https://media.iyzico.com/b/2020/08/information-circle@2x.png">
        <h2>
            {{ translations.iyzicoSignupModal.SignupBasariliBaslik }}
        </h2>
        {% for flashMessage in registerSuccessMessages %}
          <p>
              {{ flashMessage|raw }}
          </p>
        {% endfor %}
      <div class="buttonGroup">
        <a onclick="history.back()" class="button basic"><i class="icon icon--icn-leftarrow"></i>{{ translations.consumerRegisterSuccess.buttonTextBack }}</a>
        <a href="{{ translations.iyziStatic.merhantPanelUrl }}" class="button primary">{{ translations.newiyzicoNotifications.newTamam }}</a>
      </div>
    </div>
  </div>
<section class="newWhoIsiyzico gray-100-bg">
  <div class="container">
    <div class="header">
      <div class="headerTop">
        <img src="{{ asset('assets/images/content/newArrow.svg')}}"/>
        <p class="title">{{ translations.iyzicoSignupModal.SimdiNeOlacakTitle }}</p>
      </div>
    </div>
    <ul>
      <li>
        <img src="{{ asset('assets/images/icons/confirm-email.svg')}}">
        {{ translations.iyzicoSignupModal.secOne|raw }}
      </li>
      <li>
        <img src="{{ asset('assets/images/icons/upload-dochument.svg')}}">
        {{ translations.iyzicoSignupModal.secTwo|raw }}
      </li>
      <li>
        <img src="{{ asset('assets/images/icons/ready-getpay.svg')}}">
        {{ translations.iyzicoSignupModal.secThree|raw }}
      </li>
    </ul>
  </div>
</section>
{% endif %}
<script src='https://www.google.com/recaptcha/api.js?hl={{app.request.attributes.get('_locale')}}' async defer></script>
{% endblock %}
{% block footerContent %}
  {% include '@root/Partials/_footerShort.html.twig' %}
{% endblock %}
