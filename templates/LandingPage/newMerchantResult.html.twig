{% extends "landingPage.html.twig" %}
{% set memberUserId = app.session.get('memberUserId') %}
{% block pageTitle %}{{ pageContents.seo.title }}{% endblock %}
{% block description %}{{ pageContents.seo.description }}{% endblock %}
{% block openGraph %}
    <meta name="robots" content="noindex" />
    <meta property="og:title" content="{{ pageContents.seo.ogTitle }}" />
    <meta property="og:image" content="{{ pageContents.seo.ogImage }}" />
    <meta property="og:description" content="{{ pageContents.seo.ogDescription }}" />
    <meta name="robots" content="noindex">
{% endblock %}
{% block headerClasses %}full-height{% endblock %}
{% block bodyStyle %}background-color:transparent{% endblock %}

{% block bodyClass %} new-merchant mainMenu{% endblock %}
{% block headContent %}
    {% include '@root/Partials/_registerHeader.html.twig' %}
{% endblock %}
{% block main %}
  <div class="newMerchantResult">
    <div class="iyzi-container">
      <img src="https://media.iyzico.com/b/2020/08/information-circle.png" srcset="https://media.iyzico.com/b/2020/08/information-circle@2x.png">
      <h2>{{ translations.consumerRegisterSuccess.title }}</h2>
      <p>{{ translations.consumerRegisterSuccess.description }}</p>
      <div class="imageWrap">
        <img src="{{ asset('assets/images/content/personal-register.png')}}" srcset="{{ asset('assets/images/content/personal-register@2x.png')}} 2x" alt="" />
      </div>
      <div class="appDownload">
        {% if app.request.attributes.get('_locale') == "tr" %}
          <a href="https://itunes.apple.com/us/app/iyzico/id1436467445?ls=1&mt=8" target="_blank">
            <img src="{{ asset('assets/images/content/new-app-store-en.png')}}" srcset="{{ asset('assets/images/content/new-app-store-en@2x.png')}} 2x" alt="iyzico"/>
          </a>
          <a href="https://play.google.com/store/apps/details?id=com.iyzico.assistant" target="_blank">
            <img src="{{ asset('assets/images/content/new-google-play-en.png')}}" srcset="{{ asset('assets/images/content/new-google-play-en@2x.png')}} 2x" alt="iyzico"/>
          </a>
        {% else %}
          <a href="https://itunes.apple.com/us/app/iyzico/id1436467445?ls=1&mt=8" target="_blank">
            <img src="{{ asset('assets/images/content/new-app-store-en.png')}}" srcset="{{ asset('assets/images/content/new-app-store-en@2x.png')}} 2x" alt="iyzico"/>
          </a>
          <a href="https://play.google.com/store/apps/details?id=com.iyzico.assistant" target="_blank">
            <img src="{{ asset('assets/images/content/new-google-play-en.png')}}" srcset="{{ asset('assets/images/content/new-google-play-en@2x.png')}} 2x" alt="iyzico"/>
          </a>
        {% endif %}
      </div>
    </div>
  </div>
<script
  src='https://www.google.com/recaptcha/api.js?hl={{app.request.attributes.get('_locale')}}'
  async defer></script>
{% endblock %}
{% block footerContent %}
  {% include '@root/Partials/_footerShort.html.twig' %}
{% endblock %}
