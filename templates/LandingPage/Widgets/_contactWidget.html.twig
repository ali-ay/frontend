<section class="contactWidget">
<div class="contactBg">
	<div class="container">
		<div class="title">{{ translations.contactWidget.title }}</div>
		<div class="contentWrap">
			<div class="contentBox">{{ translations.contactWidget.description }}</div>
			<div class="contentBox">
				<p>
					<b>{{ translations.contactWidget.ticariScilNo }}:</b> 867612
				</p>
				<p>
					<b>{{ translations.contactWidget.vergiDairesi }}:</b> MASLAK VD. 4830343157
				</p>
