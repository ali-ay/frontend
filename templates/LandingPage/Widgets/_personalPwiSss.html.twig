<section class="iyzicoSss" id="sss">
	<div class="container">
		<div class="title">{{ pwiSss.title }}</div>
		<div class="description">{{ pwiSss.desc }}</div>
		<div class="sssWrap">
			<ul>
				{% for items in pwiSss.buyerSss %}
				{% if loop.index == 1 %}
					{% set activeClass = "menuOpen" %}
				{% else %}
					{% set activeClass = "" %}
				{% endif %}

				<li class="accordion hasSub {{ activeClass }}" onclick="ga('send', 'event', 'Button', 'Click', 'sss{{loop.index}}');">
					<div class="sssHeader">
						<div class="title">{{ items.title }}</div>
						<i class="icon icon--variable"></i>
					</div>
					<div class="description">{{ items.content|raw }}</div>
				</li>

				{% endfor %}

			</ul>
		</div>
	</div>
</section>
