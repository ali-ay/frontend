<section class="newiyziCards multipleCards">
	<div class="iyzi-container">
		{% for items in partnersolutions.features | batch(3) %}
			<div class="cardWrap">
				{% for item in items %}
					<div class="cardBox">
						<img src="{{ item.image.file }}.{{ item.image.extension }}" alt="iyzico"/>
						<h3><span class="{{ item.class }}">{{ item.colorTitle }}</span> {{ item.title }}</h3>
						<p>{{ item.content }}</p>
					</div>
				{% endfor %}
			</div>
		{% endfor %}
	</div>
</section>
