    </div>
    <div class="content">
      <h2>{{ translations.consumerAppWidget.title }}</h2>
      <ul>
        <li><i class="icon icon--pricing-check"></i>{{ translations.consumerAppWidget.bulletOne }}</li>
        <li><i class="icon icon--pricing-check"></i>{{ translations.consumerAppWidget.bulletTwo }}</li>
        <li><i class="icon icon--pricing-check"></i>{{ translations.consumerAppWidget.bulletThree }}</li>
