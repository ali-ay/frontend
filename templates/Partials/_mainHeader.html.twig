							<li><a href="{{ path('culture') }}">{{ translations.mainHeader.culture }}</a></li>
							<li><a href="{{ path('press') }}">{{ translations.mainHeader.press }}</a></li>
						</ul>
					</div>
				</div>
			</li>
		</ul>
	</div>
	<div class="mobileNavigationMenuContact mobile-navigation-components">
		<ul>
			<li class="subTitle">{{ translations.mainHeader.contact }}</li>
			<li class="description">{{ translations.mainHeader.contactDescription }}</li>
			<li>
				<div class="mobileNavigationMenuContactContent">
					<i class="icon icon--contact-phone"></i><a href="tel:+90-216-599-0100">{{ translations.iyziStatic.phoneNumber }}</a>
				</div>
				<div class="mobileNavigationMenuContactContent">
					<i class="icon icon--contact-mail"></i><a href="mailto:{{ translations.iyziStatic.infoMail }}">{{ translations.iyziStatic.infoMail }}</a>
				</div>
			</li>
		</ul>
