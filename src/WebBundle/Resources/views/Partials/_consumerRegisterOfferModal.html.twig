<div class="iyziModal consumer-register-offer-modal modal otpPopup otpSuccessModal" tabindex="-1" role="dialog" id="flash-modal" aria-labelledby="myLargeModalLabel">
	<div class="iyziModalWrap">
		<div class="iyziModalContainer">
			<div class="modalContent">
				<button type="button" class="modal-close" data-dismiss="modal">
					<i class="icon icon--popup-close" aria-hidden="true"></i>
				</button>
				<div class="modalContent">
					<i class="icon icon--contactus-success"></i>
					<h2><strong>{{ translations.consumerQuickRegister.title }}</strong></h2>
							<p>{{ translations.consumerQuickRegister.descriptiom }}</p>
							<p><strong>{{ translations.consumerQuickRegister.subDescription }}</strong></p>
						<div class="buttonGroup">
						{% if app.request.attributes.get('_locale') == "tr" %}
							<a href="https://itunes.apple.com/us/app/iyzico/id1436467445?ls=1&mt=8" target="_blank"><i class="icon icon--app-store"></i></a>
							<a href="https://play.google.com/store/apps/details?id=com.iyzico.assistant" target="_blank"><i class="icon icon--google-play"></i></a>
						{% else %}
							<a href="https://itunes.apple.com/us/app/iyzico/id1436467445?ls=1&mt=8" target="_blank"><i class="icon icon--app-store-en"></i></a>
							<a href="https://play.google.com/store/apps/details?id=com.iyzico.assistant" target="_blank"><i class="icon icon--google-play-en"></i></a>
						{% endif %}
						</div>
				</div>
			</div>
		</div>
	</div>
</div>
