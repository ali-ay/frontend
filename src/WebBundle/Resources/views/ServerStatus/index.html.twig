{% extends "::statusLandingPage.html.twig" %}

{% block pageTitle %}{{ pageInfo.seo.title }}{% endblock %}
{% block description %}{{ pageInfo.seo.description }}{% endblock %}
{% block openGraph %}
    <meta property="og:title" content="{{ pageInfo.seo.ogTitle }}" />
    <meta property="og:image" content="{{ pageInfo.seo.ogImage }}" />
    <meta property="og:description" content="{{ pageInfo.seo.ogDescription }}" />
{% endblock %}
{% block bodyClass %}personalLanding serverStatus{% endblock %}
{% block headerClasses %} header-grey{% endblock %}
{% block headerStyleIncludes %}
    <link rel="stylesheet" href="{{ asset('assets/styles/vendors/chronoline.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/styles/vendors/jquery.qtip.min.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/styles/vendors/dx.light.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/styles/vendors/dx.common.css') }}">
    <style>
        .check {
            background-color: white;
            padding: 5px;
            box-shadow: 0 0 40px 0 rgba(0, 0, 0, 0.1);
            border-radius: 50%;
            width: 50px;
            height: 50px;
            margin-bottom: 20px;
        }

        .check div {
            border-radius: 50%;
            width: 100%;
            height: 100%;
            display: flex;
            justify-content: center;
            align-items: center
        }
        .check div.up{
            background-color: #7ed321;
        }
        .check div.down{
            background-color: #cd4e6b;
        }
        .check div.loading-animation{
            background-color: transparent;
        }
        .table_container {
            box-shadow: 0 0 40px 0 rgba(0, 0, 0, 0.1);
            background-color: white;
            border-radius: 10px;
            display: flex;
            margin-bottom:30px;
            opacity:0;
            -webkit-transition: opacity 0.5s ease-in-out;
            -moz-transition: opacity 0.5s ease-in-out;
            transition: opacity 0.5s ease-in-out;
        }
        .table_container.animate-opacity{
            opacity:1;
        }

        .table_container .info {
            display: flex;
            justify-content: center;
            align-items: center;
            flex-direction: column;
            padding: 30px 35px;
            text-align: center;
            flex: 1;
            border-right: 2px solid #9b9b9b20;
        }

        .table_container .info .info_title {
            font-size: 18px;
            margin-bottom: 10px;
            min-width:170px;
        }

        .table_container .info .info_uptime {
            font-size: 16px;
        }

        .table_container .uptimes {
            flex: 5;
            padding: 30px 35px;
        }

        .table_container .uptimes .uptimes_wrapper {
            overflow: auto;
        }

        .table_container .uptimes .dates {
            display: flex;
            justify-content: space-between;
            font-size: 12px;
        }

        .table_container .uptimes .uptimes_container .days_container {
            display: flex;
            justify-content: space-between;
            margin-bottom: 10px;
            flex-wrap: nowrap;
        }

        .table_container .uptimes .uptimes_container .days_container .day {
            height: 120px;
            width: calc(100%/31/2);
            margin-right: calc(100%/31/2);
            background-color: #7ed321;
            border-radius: 12px;
            position: relative;
            overflow: hidden;
            cursor:pointer;
        }

        .table_container .uptimes .uptimes_container .days_container .day .down,
        .table_container .uptimes .uptimes_container .days_container .day .degraded {
            width: 100%;
            height: 0;
            position: absolute;
            bottom: 0;
            border-radius: 0 0 12px 12px;
        }
        .table_container .uptimes .uptimes_container .days_container .day .down{
            background-color: #cd4e6b;
        }

        .table_container .uptimes .uptimes_container .days_container .day .degraded{
            background-color: #e2c520;
        }
        .table_container .uptimes .uptimes_container .days_container .day .degraded.hasDown{
            border-radius: 0;
        }

        .table_container .uptimes .uptimes_container .days_container .day:last-child {
            margin: 0;
        }
        .arrow {
            display:none;
        }
        @media (max-width: 768px) {
            .arrow {
                display:block;
                position:absolute;
                top:60px;
                opacity:.8;
                cursor:pointer;
            }
            .arrow:hover{
                opacity:1;
            }
            .arrow.left-arrow{
                left:-15px;
            }
            .arrow.right-arrow{
                right:-15px;
                -webkit-transform: rotate(180deg);
                -moz-transform: rotate(180deg);
                -o-transform: rotate(180deg);
                -ms-transform: rotate(180deg);
                transform: rotate(180deg);
            }
            .table_container {
                flex-direction: column
            }

            .table_container .info {
                border: none;
                padding-bottom:0px;
            }

            .uptimes_container {
                width: calc(24px*31);
            }

            .table_container .uptimes .uptimes_container .days_container .day {
                width: 12px !important;
            }

            .table_container .uptimes .uptimes_container .days_container {
                flex-direction: row;
            }

            .table_container .uptimes .uptimes_container .days_container .day:first-child {
                margin-right: calc(100%/31/2);
            }

            .table_container .uptimes .uptimes_container .days_container .day:last-child {
                margin: 0;
            }

            .table_container .uptimes .dates {
                flex-direction: row
            }
        }
        .lagend{
            display:flex;
            justify-content:center;
            position:relative;
            margin-bottom:60px;
        }
        .lagend .down,.lagend .degraded{
            margin-left:20px;
        }
        .lagend div:before{
            content:" ";
            display:inline-block;
            position:relative;
            width:20px;
            height:20px;
            border-radius:50%;
            top:6px;
            margin-right:5px;
        }
        .lagend div.up:before{
            background-color:#7ed321;
        }
        .lagend div.down:before{
            background-color:#cd4e6b;
        }
        .lagend div.degraded:before{
            background-color:#e2c520;
        }
        .check-icon {
            color:#fff;
            font-size:20px;
        }
        .tooltiptext{
            display:none;
        }
        .qtip{
            border:0;
        }
        .qtip-content{
            padding:20px;
            background-color:#333;
            box-shadow: 0 0 5px 0 rgba(0, 0, 0, 0.2);
            border:none;
            border-radius:10px;
        }
        .smiley-tooltips .qtip-content{
            width:auto;
            color:#fff;
            padding:9px 9px;
            text-align:center;
            font-family: MarkPro;
            font-size:14px;
        }
        .qtip-content h3,.qtip-content p{
            font-size:12px;
            color:#fff;
            margin-bottom:5px;
            font-family: MarkPro;
        }
        .smileys{
            display:flex;
            flex-direction:row;
            justify-content:center;
        }
        .smiley{
            width:40px;
            height:40px;
            margin-right:30px;
            overflow:hidden;
            position:relative;
            cursor:pointer;
        }
        .smiley:last-of-type{
            margin-right:0px;
        }
        .smileys .background{
            width:40px;
            height:80px;
            position:relative;
            top:0px;
            transition: all .25s ease;
        }
        .smileys .background.active{
            top:-40px;
        }
        .iyzi-vote{
            background-color:#fff;
        }
        .uptimes{
            position:relative;
        }
    </style>
{% endblock %}
{% block footerClass %}{% endblock %}

