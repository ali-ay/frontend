{% extends "::landingPage.html.twig" %}
{% block pageTitle %}{{ pageContents.seo.title }}{% endblock %}
{% block description %}{{ pageContents.seo.description }}{% endblock %}
{% block openGraph %}
    <meta name="robots" content="noindex" />
    <meta property="og:title" content="{{ pageContents.seo.ogTitle }}" />
    <meta property="og:image" content="{{ pageContents.seo.ogImage }}" />
    <meta property="og:description" content="{{ pageContents.seo.ogDescription }}" />
{% endblock %}
{% block headerClasses %}full-height{% endblock %}
{% block bodyStyle %}background-color:transparent{% endblock %}

{% block bodyClass %} new-merchant mainMenu newPersonalMerchant{% endblock %}
{% block headContent %}
    {% include '@root/Partials/_registerHeader.html.twig' %}
{% endblock %}
{% block main %}
{{ render(controller('WebBundle:Partials:_consumerOfferRegisterOtpModal')) }}
  <div class="newMerchantContainer">
    <div class="newMerchantForm">
			<div class="contentWrap">
				<div class="content">
					<h2><strong>{{ translations.consumerOfferModal.title }}</strong></h2>
					<p>{{ translations.consumerOfferModal.descriptionNew }} 🤩</p>
					<div class="imageWrap">
						<img src="{{ asset('assets/images/content/personal-register.png')}}" srcset="{{ asset('assets/images/content/personal-register@2x.png')}} 2x" alt="" />
					</div>
					<div class="appDownload">
						{% if app.request.attributes.get('_locale') == "tr" %}
							<a href="https://itunes.apple.com/us/app/iyzico/id1436467445?ls=1&mt=8" target="_blank">
								<img src="{{ asset('assets/images/content/new-app-store-en.png')}}" srcset="{{ asset('assets/images/content/new-app-store-en@2x.png')}} 2x" alt="iyzico"/>
							</a>
							<a href="https://play.google.com/store/apps/details?id=com.iyzico.assistant" target="_blank">
								<img src="{{ asset('assets/images/content/new-google-play-en.png')}}" srcset="{{ asset('assets/images/content/new-google-play-en@2x.png')}} 2x" alt="iyzico"/>
							</a>
						{% else %}
							<a href="https://itunes.apple.com/us/app/iyzico/id1436467445?ls=1&mt=8" target="_blank">
								<img src="{{ asset('assets/images/content/new-app-store-en.png')}}" srcset="{{ asset('assets/images/content/new-app-store-en@2x.png')}} 2x" alt="iyzico"/>
							</a>
							<a href="https://play.google.com/store/apps/details?id=com.iyzico.assistant" target="_blank">
								<img src="{{ asset('assets/images/content/new-google-play-en.png')}}" srcset="{{ asset('assets/images/content/new-google-play-en@2x.png')}} 2x" alt="iyzico"/>
							</a>
						{% endif %}
					</div>
				</div>
			</div>
			<div class="formWrap">
				<div class="newForm">
					<div class="offerForm">
						<div class="">
							<form name="register-new-member-signup-popup" id="consumer-register-form" class="register-new-member-signup-popup" action="{{ path('register_new_member_signup') }}" method="POST">
								<input type="hidden" id="csrf-token" name="_csrf_token" value="{{ csrf_token('register-new-member-signup') }}">
								<div class="title">{{ translations.iyzicoNewMerchant.newFormTitle }}</div>
								<div class="inputWrap">
									<input type="text" name="name"  minlength="2" autocomplete="off" id="name" class="input-form input-form--large" value="" placeholder="{{ translations.consumerOfferModal.name }}" required />
								</div>
								<div class="inputWrap">
									<input type="text" name="surname"  minlength="2" autocomplete="off" id="surname" class="input-form input-form--large" value="" placeholder="{{ translations.consumerOfferModal.surName }}" required />
								</div>
								<div class="inputWrap">
									<input type="text" class="input-form input-form--large emailVal" name="personalEmail" autocomplete="off" id="personalEmail" onkeypress="return isEmail(event)" placeholder="{{ translations.consumerOfferModal.email }}" required />
								</div>
								<div class="inputWrap">
									<i class="icon icon--flags-tr"></i>
									<input type="tel" data-mask="(000) 000 0000" pattern="[0-9]*" name="personalPhone" minlength="7" autocomplete="off" id="personalPhone" value="" class="input-form input-form--large" placeholder="{{ translations.consumerOfferModal.phone }}" required />
								</div>
								<div class="inputWrap">
									<input type="password" name="password" value="" placeholder="{{ translations.consumerOfferModal.password }}" class="input-form input-form--large password-input" autocomplete="off" id="password" required onkeypress="return isNumeric(event)" maxlength="6">
									<div class="pass-eye">
										<img src="{{ asset('assets/images/pass-eye.svg') }}">
										<img src="{{ asset('assets/images/pass-eye-off.svg') }}">
									</div>
									<div class="tooltiptext">
										<span class="sixDigit">{{ translations.iyzicoSignupModal.isSixDigit }}</span>
										<span class="hasTwoConsecutiveNumbers">{{ translations.iyzicoSignupModal.hasUniqueNumbers }}</span>
										<span class="hasThreeTimesRepeatedOneBlock">{{ translations.iyzicoSignupModal.hasThreeTimesRepeatedOneBlock }}</span>
										<span class="hasThreeTimesRepeatedTwoBlock">{{ translations.iyzicoSignupModal.hasThreeTimesRepeatedTwoBlock }}</span>
										<span class="hasTreeUniqNumbers">{{ translations.iyzicoSignupModal.isFirstThreeAndLastThreeSame }}</span>
										<span class="isFirstThreeAndLastThreeSame">{{ translations.iyzicoSignupModal.hasConsecutiveNumbers }}</span>
									</div>
								</div>
								<div class="inputWrap">
									<div class="checkBoxWrap">
										<input type="checkbox" name="corporate" id="corporate" />
										<label for="corporate">{{ translations.consumerOfferModal.corporate|raw }}</label>
									</div>
								</div>
								<div class="inputWrap">
									<div class="checkBoxWrap">
										<input type="checkbox" name="kvkk" id="kvkk" />
										<label for="kvkk">{{ translations.consumerOfferModal.kvkk|raw }}</label>
									</div>
								</div>
								<div class="inputWrap">
									<div class="checkBoxWrap">
										<input type="checkbox" name="useragreement" id="useragreement" required />
										<label for="useragreement">{{ translations.consumerOfferModal.useragrrement|raw }}</label>
									</div>
								</div>
								<div class="messagebox">
									<div id="alertMessage"></div>
								</div>
								<div class="buttonGroup">
									<button onclick="javascript:$('.register-new-member-signup-popup')" type="submit" title="" class="button primary">{{ translations.buttonText.signUpNow }}</button>
									<div class="contractText">{{ translations.consumerOfferModal.agreement|raw }}</div>
								</div>
								<input type="submit" class="g-recaptcha" data-sitekey="6LcdQz4UAAAAAC2WQlZInj-6cmv3GwZR1bGg4S8J" data-size="invisible" data-callback="formSubmit"  style="position: absolute; left: -9999px; width: 1px; height: 1px;" tabindex="-1" />
							</form>
						</div>
					</div>
				</div>
			</div>
			<div class="mobileContent">
				<div class="imageWrap">
					<img src="{{ asset('assets/images/content/new-pay-with-iyzico-app-popup.png')}}" srcset="{{ asset('assets/images/content/new-pay-with-iyzico-app-popup@2x.png')}} 2x" alt="" />
				</div>
				<div class="appDownload">
					{% if app.request.attributes.get('_locale') == "tr" %}
						<a href="https://itunes.apple.com/us/app/iyzico/id1436467445?ls=1&mt=8" target="_blank">
							<img src="{{ asset('assets/images/content/new-app-store-en.png')}}" srcset="{{ asset('assets/images/content/new-app-store-en@2x.png')}} 2x" alt="iyzico"/>
						</a>
						<a href="https://play.google.com/store/apps/details?id=com.iyzico.assistant" target="_blank">
							<img src="{{ asset('assets/images/content/new-google-play-en.png')}}" srcset="{{ asset('assets/images/content/new-google-play-en@2x.png')}} 2x" alt="iyzico"/>
						</a>
					{% else %}
						<a href="https://itunes.apple.com/us/app/iyzico/id1436467445?ls=1&mt=8" target="_blank">
							<img src="{{ asset('assets/images/content/new-app-store-en.png')}}" srcset="{{ asset('assets/images/content/new-app-store-en@2x.png')}} 2x" alt="iyzico"/>
						</a>
						<a href="https://play.google.com/store/apps/details?id=com.iyzico.assistant" target="_blank">
							<img src="{{ asset('assets/images/content/new-google-play-en.png')}}" srcset="{{ asset('assets/images/content/new-google-play-en@2x.png')}} 2x" alt="iyzico"/>
						</a>
					{% endif %}
				</div>
			</div>
		</div>
  </div>
<script>
  function formSubmit (token) {
    $('#consumer-register-form').submit();
      return true;
    }
</script>
<script
  src='https://www.google.com/recaptcha/api.js?hl={{app.request.attributes.get('_locale')}}'
  async defer></script>
{% endblock %}
{% block footerContent %}
  {% include '@root/Partials/_footerShort.html.twig' %}
{% endblock %}
