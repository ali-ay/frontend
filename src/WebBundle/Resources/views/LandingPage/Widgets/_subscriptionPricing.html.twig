<section class="pricing">
	<div class="iyzi-container">
		<h2>{{ translations.subscriptionPricing.title|raw }}</h2>
		<p>{{ translations.pricing.desc }}</p>


		<div class="priceWrap">
			<div class="priceBox">
				<div class="title">{{ translations.subscriptionPricing.boxTitle }}</div>
				<div class="priceAndPercent">{{ translations.subscriptionPricing.boxSubTitle }}</div>
			</div>
		</div>


		<div class="pricingWrap">
			<div class="pricingBoxWrap">
				<div class="pricingBox">
					<div class="widgetTitle">{{ translations.subscriptionPricing.formTitle }}</div>
				</div>
			</div>
    	<div class="form offer-modal">
        <div class="offerForm">
        	<div class="signup-modal__form">
          	<form name="offer-form" id="subscription-lead-pricing" class="offer-form-subscription-pricing subForm" action="{{ path('subscription_form_get_offer') }}" method="POST">
            	<input type="hidden" id="csrf-token" name="_csrf_token" value="{{ csrf_token('subscription-offer') }}">
							<div class="inputWrap">
								<input type="text" name="phone" autocomplete="off" id="phone" class="input-form input-form--large" value="" placeholder="{{ translations.subscriptionForm.phoneNumber }}" required />
							</div>
							{% if shouldShowCaptcha %}
								<div class="buttonGroup" id="submit-button-holder-offer" style="display:none;">
									<input type="hidden" name="recaptcha-response" value="" id="recaptcha-value-offer" />
									<button onclick="javascript:$('.offer-form-subscription-pricing')" type="submit" title="" class="button primary">{{ translations.buttonText.signUpNow }}</button>
								</div>
								<div class="" style="margin-left:-20px !important;" id="recaptcha-holder-offer"></div>
              {% else %}
								<div class="buttonGroup">
									<button onclick="javascript:$('.offer-form-subscription-pricing')" type="submit" title="" class="button primary">{{ translations.buttonText.signUpNow }}</button>
								</div>
              {% endif %}
								<input type="submit" style="position: absolute; left: -9999px; width: 1px; height: 1px;" tabindex="-1" />
						</form>
					</div>
				</div>
    	</div>
			<div class="subDescription">{{ translations.subscriptionPricing.boxDescription }}</div>
		</div>
	</div>
</section>
