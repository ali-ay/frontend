<div class="iyziTabs">
  <div class="iyzi-container">
    <ul class="nav nav-tabs">
      <li class="active"><a data-toggle="tab" href="#menu1">Ücretler</a></li>
      <li><a data-toggle="tab" href="#menu2">Limitler</a></li>
    </ul>
    <div class="tab-content">
			<ul id="menu1" class="tab-pane fade in active">
				<li>
					{% for items in cardpricelist.features %}
						{% if items.buttonUrl == "feels" %}
						<ul>
							<div class="secHeader">
								{% if items.title != "" %}
									<div class="headerTitle">{{ items.title|raw }}</div>
								{% endif %}
								{% if items.title != "" %}
									<div class="headerDesc">{{ items.content }}</div>
								{% endif %}
							</div>
							{% for item in items.logos %}
							<li>
								<div class="containerWrap">
									<div class="content">
										<div class="title">{{ item.title }}</div>
										<div class="description">{{ item.alt }}</div>
									</div>
									<div class="price">{{ item.class }}</div>
								</div>
							</li>
							{% endfor %}
						</ul>
						{% endif %}
					{% endfor %}

				</li>
			</ul>
			<ul id="menu2" class="tab-pane fade">
				<li>
					{% for items in cardpricelist.features %}
						{% if items.buttonUrl == "limits" %}
						<ul>
							<div class="secHeader">
								<div class="headerTitle">{{ items.title }}</div>
								<div class="headerDesc">{{ items.content }}</div>
							</div>
							{% for item in items.logos %}
							<li>
								<div class="containerWrap">
									<div class="content">
										<div class="title">{{ item.title|raw }}</div>
										<div class="description">{{ item.alt }}</div>
									</div>
									<div class="price">{{ item.class }}</div>
								</div>
							</li>
							{% endfor %}
						</ul>
						{% endif %}
					{% endfor %}
				</li>
			</ul>
    </div>
  </div>
</div>
