{% set mainCategorySlug = app.request.get('categorySlug') %}
{% set subCategorySlug = app.request.get('subCategorySlug') %}

<section class="generalConditionsContent">
	<div class="container">
		<div class="leftMenu">
			<ul>
				<li>
					<a href="{{ path('who_we_are') }}">{{ translations.aboutUsSubMenu.whoIsiyzico }}</a>
