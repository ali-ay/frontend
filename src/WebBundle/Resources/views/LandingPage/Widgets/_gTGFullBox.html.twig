<div class="gTGFullBox">
  <div class="iyzi-container">


		{% for items in socialGroup.social %}

          <div class="boxWrap">
            <div class="imgWrap">

              {% if items.videoUrl|length > 0 %}
                <div class="container">
                  <div class="video-responsive">
                    <iframe width="640" height="360" src="https://www.youtube-nocookie.com/embed/4AQ3k0junko?rel=0&cc_load_policy=1&color=white&version=3&loop=1&playlist=4AQ3k0junko&autoplay=0" frameborder="0" allow="encrypted-media" allowfullscreen></iframe>
                  </div>
                </div>
              {% endif %}

                <img src="{{ items.image.file }}.{{ items.image.extension }}" srcset="{{ items.image.file }}@2x.{{ items.image.extension }} 2x" alt=""/>
              <div class="bundle">
                <img src="{{ items.logo.file }}.{{ items.logo.extension }}" srcset="{{ items.logo.file }}@2x.{{ items.logo.extension }} 2x" alt=""/>
              </div>
            </div>
            <h4>{{ items.title|raw }}</h4>
            <p>
              {{ items.content|raw }}
            </p>

          {% if items.buttonUrl|length > 0 %}
            <div class="buttonBox">
              <a href="{{ items.buttonUrl }}" target="_blank" class="button basic clear-blue">{{ items.buttonText }}</a>
            </div>
          {% endif %}

          </div>

		{% endfor %}

  </div>
</div>
