<section class="iyziLife">
	<div class="iyzi-container">
	{% for items in cardfeaturesscreen.features %}
		<ul>

		{% set itemIndex = 1 %}
		{% for item in items.logos %}
			{% if itemIndex is divisible by(2) %}

			{% if item.appdownload == "True" %}
			<li class="{{ item.class }}">
			{% else %}
			<li>
			{% endif %}
				<div class="itemContent">
					{{ item.title|raw }}
					{{ item.alt|raw }}
					{{ item.content|raw }}
					<div class="buttonGroup">

	          {% if deviceType == 'mobile' %}

							<a href="http://onelink.to/d9gd7t" class="button {{ item.buttononeclass }}">{{ item.buttononetext }}</a>

    	      {% else %}

      	      <a href="{{ item.buttononeurl }}" class="button {{ item.buttononeclass }}">{{ item.buttononetext }}</a>

        	  {% endif %}

						<a href="{{ item.buttontwourl }}" class="button {{ item.buttontwoclass }}">{{ item.buttontwotext }}</a>
					</div>
				</div>
				<div class="itemimg">
					<img src="{{ item.desktopimg.file }}.{{ item.desktopimg.extension }}" srcset="{{ item.desktopimg.file }}@2x.{{ item.desktopimg.extension }} 2x" alt="{{item.desktopimgalt}}" />
				</div>
			</li>

			{% else %}

			<li>
				<div class="itemimg">
					<img src="{{ item.desktopimg.file }}.{{ item.desktopimg.extension }}" srcset="{{ item.desktopimg.file }}@2x.{{ item.desktopimg.extension }} 2x" alt="{{item.desktopimgalt}}" />
				</div>
				<div class="itemContent">
					{{ item.title|raw }}
					{{ item.alt|raw }}
					{{ item.content|raw }}
					<div class="buttonGroup">
						<a href="{{ item.buttononeurl }}" class="button {{ item.buttononeclass }}">{{ item.buttononetext }}</a>
					</div>
				</div>
			</li>

			{% endif %}
			{% set itemIndex = itemIndex + 1 %}
		{% endfor %}

		</ul>
		{% endfor %}
	</div>
</section>

